{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "laya-computer-use": {
      "type": "local",
      "command": ["C:/path/to/laya-deploy/.venv/Scripts/laya-deploy.exe", "mcp"],
      "enabled": true,
