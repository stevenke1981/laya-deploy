# ===== 服務位址 =====
# 預設只綁 127.0.0.1。綁到其他介面（0.0.0.0、區網 IP）時必須設 LAYA_DEPLOY_API_KEY，否則拒絕啟動。
LAYA_DEPLOY_HOST=127.0.0.1
LAYA_DEPLOY_PORT=8100
# LAYA_DEPLOY_API_KEY=            # 設了就要求 Authorization: Bearer <key>

# ===== 模型 =====
# 請求的 model 欄位若不是 laya checkpoint 名稱（例如 decision-cua 送來的 microsoft/microsoft-decision-1），
# 就用這個預設：english | multilingual | typed-decisions | auto（auto = 依語言自動路由）
LAYA_DEPLOY_DEFAULT_MODEL=multilingual
# 啟動時預先載入：逗號清單、all 或 none（none = 第一次請求時才載入，約 7–11 秒）
LAYA_DEPLOY_PRELOAD=multilingual
# 同時常駐的 checkpoint 數（實測 VRAM：english 1.57 GiB、multilingual 1.22 GiB）
# LAYA_DEPLOY_MAX_LOADED=2
# LAYA_DEPLOY_DEVICE=             # 空白 = 有 CUDA 用 cuda，否則 cpu
# LAYA_DEPLOY_MAX_LEN=0           # 0 = checkpoint 預設 token 上限；長文件可設 4096/8192（multilingual）

# ===== Hugging Face =====
# HF_HOME=D:\hf-cache             # 模型快取位置（預設 %USERPROFILE%\.cache\huggingface）
# HF_TOKEN=                       # 公開模型不需要
